{
  "opencollection": "1.0.0",
  "info": {
    "name": "TheSports Football Competitions Standings API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "user_key",
      "value": "{{user_key}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Standings",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Standings",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.thesports.com/v1/football/standings/list",
            "params": [
              {
                "name": "user_key",
                "value": "",
                "type": "query",
                "description": "Your API authentication key."
              },
              {
                "name": "competition_id",
                "value": "",
                "type": "query",
                "description": "The competition ID."
              },
              {
                "name": "season_id",
                "value": "",
                "type": "query",
                "description": "The season ID."
              }
            ]
          },
          "docs": "Returns the league table/standings for a competition and season."
        }
      ]
    }
  ],
  "bundled": true
}